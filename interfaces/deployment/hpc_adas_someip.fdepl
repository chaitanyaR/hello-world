import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-SOMEIP_deployment_spec.fdepl"
import "../service_definitions/hpc_adas.fidl"

define org.genivi.commonapi.someip.deployment for interface org.sdv.hpc.adas.AdasZoneService {
    SomeIpServiceID = 0x1002

    method GetSensorFrame       { SomeIpMethodID = 0x0001 }
    method SendActuatorCommand  { SomeIpMethodID = 0x0002 }
    method ReadDtcs             { SomeIpMethodID = 0x0003 }
    method RunSensorCalibration { SomeIpMethodID = 0x0004 }

    broadcast SensorDataEvent  { SomeIpEventID = 0x8001; SomeIpEventGroups = { 0x0012 } }
    broadcast SafetyStateEvent { SomeIpEventID = 0x8002; SomeIpEventGroups = { 0x0012 } }
}

define org.genivi.commonapi.someip.deployment for provider as AdasEcu {
    instance org.sdv.hpc.adas.AdasZoneService {
        SomeIpInstanceID = 0x0001
    }
}
