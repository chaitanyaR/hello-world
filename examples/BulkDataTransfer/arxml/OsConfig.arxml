<?xml version="1.0" encoding="UTF-8"?>
<!--
  OsConfig.arxml
  AUTOSAR Release R22-11
  ECUC OS Configuration for BulkDataTransfer ECU
  Configures: OsCounter_SystemTimer (1 ms), OsTask_10ms (priority 5),
              OsAlarm_10ms (period 10 ms, activates OsTask_10ms)
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0
                             AUTOSAR_00049.xsd">
  <ADMIN-DATA>
    <LANGUAGE>FOR-ALL</LANGUAGE>
  </ADMIN-DATA>
  <AR-PACKAGES>
    <!-- ================================================================== -->
    <!-- ECUC Parameter Value Collection                                     -->
    <!-- ================================================================== -->
    <AR-PACKAGE>
      <SHORT-NAME>ActiveEcuc</SHORT-NAME>
      <ELEMENTS>
        <ECUC-VALUE-COLLECTION>
          <SHORT-NAME>BulkDataTransfer_EcucValues</SHORT-NAME>
          <ECUC-VALUES>
            <ECUC-MODULE-CONFIGURATION-VALUES-REF-CONDITIONAL>
              <ECUC-MODULE-CONFIGURATION-VALUES-REF>
                /ActiveEcuc/Os
              </ECUC-MODULE-CONFIGURATION-VALUES-REF>
            </ECUC-MODULE-CONFIGURATION-VALUES-REF-CONDITIONAL>
          </ECUC-VALUES>
        </ECUC-VALUE-COLLECTION>

        <!-- ============================================================== -->
        <!-- Os Module ECUC Configuration                                    -->
        <!-- ============================================================== -->
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>Os</SHORT-NAME>
          <CONTAINERS>

            <!-- ---------------------------------------------------------- -->
            <!-- OsOS – global OS settings                                   -->
            <!-- ---------------------------------------------------------- -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>OsOS</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">
                /AUTOSAR/Os/OsOS
              </DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">
                    /AUTOSAR/Os/OsOS/OsScalabilityClass
                  </DEFINITION-REF>
                  <!-- SC1: single application, no memory protection -->
                  <VALUE>SC1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">
                    /AUTOSAR/Os/OsOS/OsUseGetServiceId
                  </DEFINITION-REF>
                  <VALUE>false</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">
                    /AUTOSAR/Os/OsOS/OsUseParameterAccess
                  </DEFINITION-REF>
                  <VALUE>false</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">
                    /AUTOSAR/Os/OsOS/OsStatus
                  </DEFINITION-REF>
                  <!-- EXTENDED gives full error detection in development -->
                  <VALUE>EXTENDED</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- ---------------------------------------------------------- -->
            <!-- OsAppMode – OSDEFAULTAPPMODE                                -->
            <!-- ---------------------------------------------------------- -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>OSDEFAULTAPPMODE</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">
                /AUTOSAR/Os/OsAppMode
              </DEFINITION-REF>
            </ECUC-CONTAINER-VALUE>

            <!-- ---------------------------------------------------------- -->
            <!-- OsCounter – hardware system timer at 1 ms resolution        -->
            <!-- ---------------------------------------------------------- -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>OsCounter_SystemTimer</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">
                /AUTOSAR/Os/OsCounter
              </DEFINITION-REF>
              <PARAMETER-VALUES>
                <!-- MAXALLOWEDVALUE: largest tick value before wrap (2^32-1) -->
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">
                    /AUTOSAR/Os/OsCounter/OsCounterMaxAllowedValue
                  </DEFINITION-REF>
                  <VALUE>4294967295</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <!-- MINCYCLE: minimum alarm period in ticks (1 tick = 1 ms) -->
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">
                    /AUTOSAR/Os/OsCounter/OsCounterMinCycle
                  </DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <!-- TICKSPERBASE: 1 tick == 1 ms -->
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">
                    /AUTOSAR/Os/OsCounter/OsCounterTicksPerBase
                  </DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">
                    /AUTOSAR/Os/OsCounter/OsCounterType
                  </DEFINITION-REF>
                  <!-- HARDWARE counter driven by the MCU system tick -->
                  <VALUE>HARDWARE</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- ---------------------------------------------------------- -->
            <!-- OsTask – OsTask_10ms                                        -->
            <!--   Priority : 5  (mid-range; above idle, below ISR)         -->
            <!--   Schedule : FULL (preemptive)                              -->
            <!--   Activation: 1 (single activation only)                   -->
            <!--   Stack    : 512 bytes                                      -->
            <!--   Autostart: false (started via alarm)                      -->
            <!-- ---------------------------------------------------------- -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>OsTask_10ms</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">
                /AUTOSAR/Os/OsTask
              </DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">
                    /AUTOSAR/Os/OsTask/OsTaskPriority
                  </DEFINITION-REF>
                  <VALUE>5</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">
                    /AUTOSAR/Os/OsTask/OsTaskActivation
                  </DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">
                    /AUTOSAR/Os/OsTask/OsTaskSchedule
                  </DEFINITION-REF>
                  <VALUE>FULL</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">
                    /AUTOSAR/Os/OsTask/OsTaskAutostart
                  </DEFINITION-REF>
                  <VALUE>false</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <!-- OsTaskStackSize in bytes -->
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">
                    /AUTOSAR/Os/OsTask/OsTaskStackSize
                  </DEFINITION-REF>
                  <VALUE>512</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- ---------------------------------------------------------- -->
            <!-- OsAlarm – OsAlarm_10ms                                      -->
            <!--   Attached counter : OsCounter_SystemTimer                  -->
            <!--   Action           : ActivateTask(OsTask_10ms)              -->
            <!--   Period           : 10 ticks (10 ms at 1 tick/ms)          -->
            <!--   Offset           : 5 ticks (initial phase offset)         -->
            <!--   Autostart mode   : OSDEFAULTAPPMODE                       -->
            <!-- ---------------------------------------------------------- -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>OsAlarm_10ms</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">
                /AUTOSAR/Os/OsAlarm
              </DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">
                    /AUTOSAR/Os/OsAlarm/OsAlarmCounterRef
                  </DEFINITION-REF>
                  <VALUE-REF DEST="ECUC-CONTAINER-VALUE">
                    /ActiveEcuc/Os/OsCounter_SystemTimer
                  </VALUE-REF>
                </ECUC-REFERENCE-VALUE>
              </PARAMETER-VALUES>
              <SUB-CONTAINERS>
                <!-- Alarm action: activate the 10 ms task -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>OsAlarmActivateTask</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">
                    /AUTOSAR/Os/OsAlarm/OsAlarmActivateTask
                  </DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">
                        /AUTOSAR/Os/OsAlarm/OsAlarmActivateTask/OsAlarmActivateTaskRef
                      </DEFINITION-REF>
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">
                        /ActiveEcuc/Os/OsTask_10ms
                      </VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>
                <!-- Autostart: cyclic, period=10 ms, offset=5 ms -->
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>OsAlarmAutostart</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">
                    /AUTOSAR/Os/OsAlarm/OsAlarmAutostart
                  </DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">
                        /AUTOSAR/Os/OsAlarm/OsAlarmAutostart/OsAlarmAlarmTime
                      </DEFINITION-REF>
                      <!-- Initial offset in ticks -->
                      <VALUE>5</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">
                        /AUTOSAR/Os/OsAlarm/OsAlarmAutostart/OsAlarmCycleTime
                      </DEFINITION-REF>
                      <!-- Cyclic period: 10 ticks = 10 ms -->
                      <VALUE>10</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">
                        /AUTOSAR/Os/OsAlarm/OsAlarmAutostart/OsAlarmAutostartType
                      </DEFINITION-REF>
                      <VALUE>ABSOLUTE</VALUE>
                    </ECUC-TEXTUAL-PARAM-VALUE>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">
                        /AUTOSAR/Os/OsAlarm/OsAlarmAutostart/OsAlarmAppModeRef
                      </DEFINITION-REF>
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">
                        /ActiveEcuc/Os/OSDEFAULTAPPMODE
                      </VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>
              </SUB-CONTAINERS>
            </ECUC-CONTAINER-VALUE>

          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
